VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX).
# Public by design, but it lives here so it is never hardcoded in the page and
# so a fork or preview build sends nothing. Absent = analytics fully off.
VITE_GA4_ID=

# Public totals endpoint for the "students home safe" counter. Absent until the
# Backend ships it; the site then uses the numbers baked into siteStats.ts.
VITE_STATS_ENDPOINT=
